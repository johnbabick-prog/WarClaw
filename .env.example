# ═══════════════════════════════════════════════════════════════
# WarClaw v2.1 — Environment Variables
# Copy to .env and customize for your deployment.
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
WARCLAW_HOST=0.0.0.0
WARCLAW_PORT=7070

# ── Security ──────────────────────────────────────────────────
# Set an API key to require X-API-Key header on all /api/* routes.
# Leave blank for open LAN access (default for isolated ship networks).
WARCLAW_API_KEY=

# ── AI Model ──────────────────────────────────────────────────
# Path to a GGUF model file. Leave blank to load via the UI.
# Example: WARCLAW_MODEL=/app/models/mistral-7b-instruct-v0.2.Q5_K_M.gguf
WARCLAW_MODEL=

# Context window size (tokens). Higher = more memory usage.
WARCLAW_CTX=4096

# CPU threads for inference. Default: number of CPU cores.
WARCLAW_THREADS=4

# GPU layers to offload. 0 = CPU only. Set higher for GPU acceleration.
WARCLAW_GPU_LAYERS=0

# ── LAN Monitoring ────────────────────────────────────────────
# TCP connect timeout for port probing (seconds).
WARCLAW_SCAN_TIMEOUT=3.0

# Network interface for monitoring. Blank = auto-detect.
WARCLAW_IFACE=

# ── Workers ───────────────────────────────────────────────────
# Uvicorn workers. Keep at 1 for WebSocket + agent support.
WARCLAW_WORKERS=1

# Log level: debug, info, warning, error
WARCLAW_LOG=info
